# Plan B: si subiste TODO el proyecto dentro de public_html, esto redirige internamente
# cada petición a public/, así ningún archivo de config/, src/, vendor/ queda expuesto.
# (Lo ideal igual es que solo el contenido de public/ quede en public_html.)
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>

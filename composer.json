{
    "name": "pipo/asistente",
    "description": "Pipo - Asistente personal con IA (PHP + MySQL)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "anthropic-ai/sdk": "^1.8",
        "guzzlehttp/guzzle": "^8.5",
        "phpmailer/phpmailer": "^7.2",
        "webklex/php-imap": "^6.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
